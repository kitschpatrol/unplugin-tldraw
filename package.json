{
	"name": "@kitschpatrol/unplugin-tldraw",
	"version": "1.1.4",
	"description": "Unplugin for module-style import of local tldraw .tldr files with automatic conversion to SVG or PNG.",
	"keywords": [
		"tldraw",
		"tldr",
		"unplugin",
		"vite",
		"webpack",
		"rspack",
		"rollup",
		"rolldown",
		"esbuild",
		"farm",
		"bun",
		"nuxt",
		"diagram",
		"drawing",
		"whiteboard",
		"sketch",
		"import",
		"npm-package"
	],
	"homepage": "https://github.com/kitschpatrol/unplugin-tldraw",
	"bugs": "https://github.com/kitschpatrol/unplugin-tldraw/issues",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/kitschpatrol/unplugin-tldraw.git"
	},
	"license": "MIT",
	"author": {
		"name": "Eric Mika",
		"email": "eric@ericmika.com",
		"url": "https://ericmika.com"
	},
	"sideEffects": false,
	"type": "module",
	"exports": {
		".": "./dist/index.js",
		"./*": "./*",
		"./api": "./dist/api.js",
		"./bun": "./dist/bun.js",
		"./client": {
			"types": "./dist/client.d.ts"
		},
		"./esbuild": "./dist/esbuild.js",
		"./farm": "./dist/farm.js",
		"./nuxt": "./dist/nuxt.js",
		"./rolldown": "./dist/rolldown.js",
		"./rollup": "./dist/rollup.js",
		"./rspack": "./dist/rspack.js",
		"./vite": "./dist/vite.js",
		"./webpack": "./dist/webpack.js"
	},
	"main": "./dist/index.js",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"typesVersions": {
		"*": {
			"*": [
				"./dist/*",
				"./*"
			]
		}
	},
	"files": [
		"dist"
	],
	"scripts": {
		"build": "tsdown",
		"clean-deep": "shx rm -f pnpm-lock.yaml && git clean -fdX -e !.claude/",
		"dev": "tsdown --watch",
		"fix": "ksc fix",
		"lint": "ksc lint",
		"play": "poptab && pnpm -C playground run dev",
		"prepare": "skills experimental_sync -y -f",
		"release": "bumpp --commit 'Release: %s' && pnpm build && pnpm publish --otp $(op item get npm --otp)",
		"test": "vitest run",
		"test:browser": "vitest run --config vitest.browser.config.ts"
	},
	"dependencies": {
		"@kitschpatrol/tldraw-cli": "^6.1.0",
		"@types/node": "~24.13.3",
		"defu": "^6.1.7",
		"lognow": "^0.8.4",
		"p-limit": "^7.3.3",
		"pretty-bytes": "^7.2.0",
		"pretty-ms": "^9.3.1",
		"unplugin": "^3.4.0"
	},
	"devDependencies": {
		"@farmfe/core": ">=1.7.11",
		"@kitschpatrol/shared-config": "^8.12.1",
		"@nuxt/kit": "^4.6.0",
		"@nuxt/schema": "^4.6.0",
		"@rspack/core": "^2.2.8",
		"@vitest/browser-playwright": "^5.0.3",
		"bumpp": "^12.3.0",
		"esbuild": "*",
		"playwright": "^1.63.0",
		"poptab": "^1.2.1",
		"rolldown": "^1.2.12",
		"rollup": "^4.64.0",
		"shx": "^0.4.0",
		"skills": "^1.7.0",
		"tsdown": "^0.23.0",
		"typescript": "~6.0.3",
		"vite": "^8.3.2",
		"vitest": "^5.0.3",
		"webpack": "^5.111.1"
	},
	"peerDependencies": {
		"@farmfe/core": ">=1",
		"@nuxt/kit": "^3 || ^4",
		"@nuxt/schema": "^3 || ^4",
		"@rspack/core": "^1 || ^2",
		"esbuild": "*",
		"rolldown": ">=1.0.0-rc.1",
		"rollup": "^3 || ^4",
		"vite": ">=3",
		"webpack": "^4 || ^5"
	},
	"peerDependenciesMeta": {
		"@farmfe/core": {
			"optional": true
		},
		"@nuxt/kit": {
			"optional": true
		},
		"@nuxt/schema": {
			"optional": true
		},
		"@rspack/core": {
			"optional": true
		},
		"esbuild": {
			"optional": true
		},
		"rolldown": {
			"optional": true
		},
		"rollup": {
			"optional": true
		},
		"vite": {
			"optional": true
		},
		"webpack": {
			"optional": true
		}
	},
	"packageManager": "pnpm@12.9.1",
	"engines": {
		"node": "^24.16.0 || >=26.3.0"
	},
	"publishConfig": {
		"access": "public"
	}
}
